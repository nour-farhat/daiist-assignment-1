        "#Costs, cut-offs and the three tiers\n",
        "# assumptions (per applicant, 10-year horizon)\n",
        "COSTS = {\n",
        "    \"claim\": 30_000,           # what one CHD claim costs the insurer\n",
        "    \"programme\": 1_500,        # full prevention programme per person\n",
        "    \"programme_effect\": 0.30,  # share of CHD claims the full programme prevents\n",
        "    \"light\": 200,              # light plan (annual check-up + reminders) per person\n",
        "    \"light_effect\": 0.10,      # share of claims the light plan prevents\n",
        "}\n",
        "C, P, e = COSTS[\"claim\"], COSTS[\"programme\"], COSTS[\"programme_effect\"]\n",
        "L, e_l = COSTS[\"light\"], COSTS[\"light_effect\"]\n",
        "\n",
        "# expected cost of each action for someone with risk p:\n",
        "#   nothing: p*C      light: L + p*(1-e_l)*C      full: P + p*(1-e)*C\n",
        "# setting them equal gives the two cut-offs\n",
        "t_low = L / (e_l * C)                 # light plan beats doing nothing above this\n",
        "t_high = (P - L) / ((e - e_l) * C)    # full programme beats light plan above this\n",
        "print(f\"t_low = {t_low:.3f}   t_high = {t_high:.3f}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
