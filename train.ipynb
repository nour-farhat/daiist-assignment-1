        "# Split 60/20/20 (train/validation/test)\n",
        "# one row = one person and no dates, so a random split doesn't leak the future\n",
        "# stratify keeps the ~15% CHD rate the same in all three sets\n",
        "X = df.drop(columns=TARGET)\n",
        "y = df[TARGET]\n",
        "\n",
        "X_train, X_tmp, y_train, y_tmp = train_test_split(\n",
        "    X, y, test_size=0.4, stratify=y, random_state=SEED\n",
        ")\n",
        "X_val, X_test, y_val, y_test = train_test_split(\n",
        "    X_tmp, y_tmp, test_size=0.5, stratify=y_tmp, random_state=SEED\n",
        ")\n",
        "print(\"train:\", X_train.shape, \"| val:\", X_val.shape, \"| test:\", X_test.shape)\n",
        "print(\"CHD rate in each set:\",\n",
        "      round(y_train.mean(), 3), round(y_val.mean(), 3), round(y_test.mean(), 3))"
      ],
