    {
      "cell_type": "code",
      "source": [
        "#Feature engineering\n",
        "def add_features(X):\n",
        "    X = X.copy()\n",
        "    # education: one-hot, level 1 is the reference\n",
        "    for lvl in [2, 3, 4]:\n",
        "        X[f\"edu_{lvl}\"] = (X[\"education\"] == lvl).astype(int)\n",
        "    # glucose: log for the tail + flag for the diabetic range\n",
        "    X[\"log_glucose\"] = np.log(X[\"glucose\"])\n",
        "    X[\"glucose_diabetic\"] = (X[\"glucose\"] >= 126).astype(int)\n",
        "    # simple clinical flags\n",
        "    X[\"heavy_smoker\"] = (X[\"cigsPerDay\"] > 20).astype(int)\n",
        "    X[\"obese\"] = (X[\"BMI\"] >= 30).astype(int)\n",
        "    X[\"high_chol\"] = (X[\"totChol\"] >= 240).astype(int)\n",
        "    # interaction: high BP looked worse in older people\n",
        "    X[\"age_x_sysBP\"] = X[\"age\"] * X[\"sysBP\"] / 100\n",
        "    # smoking exposure over a lifetime (rough pack-years: packs/day x years since 18)\n",
        "    X[\"pack_years\"] = X[\"cigsPerDay\"] / 20 * (X[\"age\"] - 18).clip(lower=0)\n",
        "    # \"hidden\" risk the applicant may not know about\n",
        "    X[\"undiagnosed_hyp\"] = ((X[\"prevalentHyp\"] == 0) & (X[\"sysBP\"] >= 140)).astype(int)\n",
        "    X[\"uncontrolled_bp\"] = ((X[\"BPMeds\"] == 1) & (X[\"sysBP\"] >= 140)).astype(int)\n",
        "    X[\"undiagnosed_diab\"] = ((X[\"diabetes\"] == 0) & (X[\"glucose\"] >= 126)).astype(int)\n",
        "    # how many classic risk factors at once (easy for an underwriter to read)\n",
        "    X[\"risk_factor_count\"] = ((X[\"cigsPerDay\"] > 0).astype(int) + X[\"prevalentHyp\"] + X[\"diabetes\"]\n",
        "                              + X[\"high_chol\"] + X[\"obese\"] + X[\"glucose_diabetic\"])\n",
        "    return X\n",
        "\n",
        "\n",
        "X_train_f = add_features(X_train_c)\n",
        "X_val_f = add_features(X_val_c)\n",
        "X_test_f = add_features(X_test_c)\n",
        "\n",
        "new_cols = [c for c in X_train_f.columns if c not in X_train.columns]\n",
        "print(X_train_f[new_cols].describe().T[[\"mean\", \"min\", \"max\"]].round(2))"
