      "source": [
        "#eda\n",
        "#continuous features (CHD vs no CHD)\n",
        "cont_cols = [\"age\", \"cigsPerDay\", \"totChol\", \"sysBP\", \"diaBP\", \"BMI\", \"heartRate\", \"glucose\"]\n",
        "\n",
        "fig, axes = plt.subplots(2, 4, figsize=(16, 6.5))\n",
        "for ax, c in zip(axes.ravel(), cont_cols):\n",
        "    ax.hist(df.loc[df[TARGET] == 0, c].dropna(), bins=30, alpha=0.6, density=True, label=\"no CHD\")\n",
        "    ax.hist(df.loc[df[TARGET] == 1, c].dropna(), bins=30, alpha=0.6, density=True, label=\"CHD\")\n",
        "    ax.set_title(c)\n",
        "axes[0, 0].legend()\n",
        "plt.suptitle(\"Continuous features by 10 year CHD outcome\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
