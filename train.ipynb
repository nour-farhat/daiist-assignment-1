          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# the extra ideas, each added on its own to set f\n",
        "BASE = steps[\"f. e + age x sysBP\"]\n",
        "extras = [\"pack_years\", \"undiagnosed_hyp\", \"uncontrolled_bp\", \"undiagnosed_diab\",\n",
        "          \"risk_factor_count\", \"glucose_diabetic\", \"heavy_smoker\", \"obese\", \"glucose_missing\"]\n",
        "base_ll = cv_score(BASE)[\"CV log loss\"]\n",
        "rows = [{\"added\": name, \"CV log loss\": cv_score(BASE + [name])[\"CV log loss\"]} for name in extras]\n",
        "extra_table = pd.DataFrame(rows).set_index(\"added\")\n",
        "extra_table[\"change vs set f\"] = extra_table[\"CV log loss\"] - base_ll\n",
        "print(\"set f CV log loss:\", round(base_ll, 4))\n",
        "print(extra_table.sort_values(\"change vs set f\").round(4))\n",
        "print(\"\\nnegative change = better. differences under ~0.002 are noise (sd across folds ~0.01)\")"
