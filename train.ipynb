    {
      "cell_type": "code",
      "source": [
        "#Missing values\n",
        "# fill values come from TRAIN only, then reused on val, test and in the app (no leakage)\n",
        "# measurements -> median (not pulled up by extreme values), categories -> most common value\n",
        "fill_values = {c: float(X_train[c].median()) for c in [\"totChol\", \"BMI\", \"heartRate\", \"glucose\"]}\n",
        "for c in [\"education\", \"BPMeds\"]:\n",
        "    fill_values[c] = float(X_train[c].mode()[0])\n",
        "# all 29 missing cigsPerDay rows are smokers, so 0 would be wrong: use the smokers' median\n",
        "fill_values[\"cigsPerDay_smoker\"] = float(\n",
        "    X_train.loc[X_train[\"currentSmoker\"] == 1, \"cigsPerDay\"].median()\n",
        ")\n",
        "print(fill_values)\n",
        "\n",
        "\n",
        "def impute(X, fill):\n",
        "    X = X.copy()\n",
        "    X[\"glucose_missing\"] = X[\"glucose\"].isna().astype(int)  # flag before filling\n",
        "    for c in [\"totChol\", \"BMI\", \"heartRate\", \"glucose\", \"education\", \"BPMeds\"]:\n",
        "        X[c] = X[c].fillna(fill[c])\n",
        "    smoker_fill = np.where(X[\"currentSmoker\"] == 1, fill[\"cigsPerDay_smoker\"], 0)\n",
        "    X[\"cigsPerDay\"] = X[\"cigsPerDay\"].fillna(pd.Series(smoker_fill, index=X.index))\n",
        "    return X\n",
        "\n",
        "\n",
        "X_train_c = impute(X_train, fill_values)\n",
        "X_val_c = impute(X_val, fill_values)\n",
        "X_test_c = impute(X_test, fill_values)"
      ],
