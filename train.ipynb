    {
      "cell_type": "code",
      "source": [
        "#Model 2: manual PyTorch loop\n",
        "def bce_loss(y_pred, y):\n",
        "    eps = 1e-7\n",
        "    y_pred = y_pred.clamp(eps, 1 - eps)  # avoid log(0)\n",
        "    return -(y * torch.log(y_pred) + (1 - y) * torch.log(1 - y_pred)).mean()\n",
        "\n",
        "\n",
        "def train_manual(lr, n_epochs, verbose=False):\n",
        "    torch.manual_seed(SEED)\n",
        "    w = torch.zeros(n_features, requires_grad=True)\n",
        "    b = torch.zeros(1, requires_grad=True)\n",
        "    history = []\n",
        "    for epoch in range(n_epochs):\n",
        "        y_pred = torch.sigmoid(Xtr_t @ w + b)\n",
        "        loss = bce_loss(y_pred, ytr_t) + LAMBDA * (w ** 2).sum()\n",
        "\n",
        "        loss.backward()\n",
        "        with torch.no_grad():          # the update itself isn't tracked\n",
        "            w -= lr * w.grad\n",
        "            b -= lr * b.grad\n",
        "        w.grad.zero_()                 # reset, otherwise gradients add up\n",
        "        b.grad.zero_()\n",
        "\n",
        "        history.append(loss.item())\n",
        "        if verbose and epoch % 1000 == 0:\n",
        "            print(f\"epoch {epoch:5d}  loss {loss.item():.5f}\")\n",
        "    return w.detach(), b.detach(), history\n",
        "\n",
        "\n",
        "# only tuned knob here: learning rate\n",
        "rows = []\n",
        "for lr in [0.01, 0.1, 1.0]:\n",
        "    w_, b_, h_ = train_manual(lr, N_EPOCHS)\n",
        "    p = torch.sigmoid(Xva_t @ w_ + b_).numpy()\n",
        "    rows.append({\"lr\": lr, \"final train loss\": h_[-1], \"val log loss\": log_loss(yva, p)})\n",
        "lr_table_manual = pd.DataFrame(rows).set_index(\"lr\")\n",
        "print(lr_table_manual.round(5))\n",
        "\n",
        "LR_MANUAL = float(lr_table_manual[\"val log loss\"].idxmin())\n",
        "w_manual, b_manual, hist_manual = train_manual(LR_MANUAL, N_EPOCHS, verbose=True)\n",
        "print(\"chosen lr:\", LR_MANUAL)"
      ],
