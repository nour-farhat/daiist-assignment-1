    {
      "cell_type": "code",
      "source": [
        "#Which features help?\n",
        "# validation only has ~129 CHD cases, too few to see small differences\n",
        "# so each feature set is scored with repeated 5-fold CV on TRAIN (5 x 5 = 25 scores)\n",
        "# scaler sits inside the pipeline so it is refitted on every fold\n",
        "cv = RepeatedStratifiedKFold(n_splits=5, n_repeats=5, random_state=SEED)\n",
        "\n",
        "\n",
        "def cv_score(cols):\n",
        "    pipe = make_pipeline(StandardScaler(), LogisticRegression(max_iter=3000))\n",
        "    s = cross_validate(pipe, X_train_f[cols], y_train, cv=cv, scoring=[\"roc_auc\", \"neg_log_loss\"])\n",
        "    return {\"n features\": len(cols),\n",
        "            \"CV AUC\": s[\"test_roc_auc\"].mean(),\n",
        "            \"CV log loss\": -s[\"test_neg_log_loss\"].mean(),\n",
        "            \"log loss sd\": s[\"test_neg_log_loss\"].std()}\n",
        "\n",
        "\n",
        "def swap(cols, old, new):\n",
        "    cols = [c for c in cols if c not in old]\n",
        "    return cols + [c for c in new if c not in cols]\n",
        "\n",
        "\n",
        "RAW = [\"male\", \"age\", \"education\", \"currentSmoker\", \"cigsPerDay\", \"BPMeds\", \"prevalentStroke\",\n",
        "       \"prevalentHyp\", \"diabetes\", \"totChol\", \"sysBP\", \"diaBP\", \"BMI\", \"heartRate\", \"glucose\"]\n",
        "EDU = [\"edu_2\", \"edu_3\", \"edu_4\"]\n",
        "# diaBP is 0.78 correlated with sysBP, currentSmoker is implied by cigsPerDay > 0,\n",
        "# heartRate and BMI barely differ between groups in step 3\n",
        "DROP = [\"diaBP\", \"currentSmoker\", \"heartRate\", \"BMI\"]\n",
        "\n",
        "steps = {}\n",
        "steps[\"a. raw columns\"] = RAW\n",
        "steps[\"b. + education one-hot\"] = swap(RAW, [\"education\"], EDU)\n",
        "steps[\"c. + all flags\"] = steps[\"b. + education one-hot\"] + [\n",
        "    \"glucose_diabetic\", \"glucose_missing\", \"heavy_smoker\", \"obese\", \"high_chol\"]\n",
        "steps[\"d. b minus redundant/weak\"] = [c for c in steps[\"b. + education one-hot\"] if c not in DROP]\n",
        "steps[\"e. d + log glucose\"] = swap(steps[\"d. b minus redundant/weak\"], [\"glucose\"], [\"log_glucose\"])\n",
        "steps[\"f. e + age x sysBP\"] = steps[\"e. d + log glucose\"] + [\"age_x_sysBP\"]\n",
        "\n",
        "fe_table = pd.DataFrame({name: cv_score(cols) for name, cols in steps.items()}).T\n",
        "print(fe_table.round(4))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
