    {
      "cell_type": "code",
      "source": [
        "# CHD rate inside groups: shows which relationships are straight lines and which aren't\n",
        "groups = {\n",
        "    \"age band\": pd.cut(df[\"age\"], [30, 40, 50, 60, 70]),\n",
        "    \"systolic BP\": pd.cut(df[\"sysBP\"], [0, 120, 130, 140, 160, 300]),\n",
        "    \"cigs per day\": pd.cut(df[\"cigsPerDay\"], [-1, 0, 10, 20, 70]),\n",
        "    \"education\": df[\"education\"],\n",
        "}\n",
        "\n",
        "fig, axes = plt.subplots(1, 4, figsize=(17, 4))\n",
        "for ax, (name, g) in zip(axes, groups.items()):\n",
