      "source": [
        "# same objective in PyTorch: sklearn minimises C*sum(BCE) + 0.5*||w||^2\n",
        "# dividing by C*n gives the same minimum: mean(BCE) + lambda*||w||^2, lambda = 1/(2*n*C), bias not penalised\n",
        "n_train = Xtr.shape[0]\n",
        "LAMBDA = 1.0 / (2 * n_train * BEST_C)\n",
        "print(\"lambda for both PyTorch versions:\", LAMBDA)\n",
        "\n",
        "Xtr_t = torch.tensor(Xtr, dtype=torch.float32)\n",
        "ytr_t = torch.tensor(ytr, dtype=torch.float32)\n",
        "Xva_t = torch.tensor(Xva, dtype=torch.float32)\n",
        "Xte_t = torch.tensor(Xte, dtype=torch.float32)\n",
        "n_features = Xtr.shape[1]\n",
        "N_EPOCHS = 5000"
