    {
      "cell_type": "code",
      "source": [
        "def policy_cost(y_true, p, t_full, t_light):\n",
        "    # total cost of the 3-tier policy: full programme above t_full, light plan between, nothing below\n",
        "    y_true = np.asarray(y_true)\n",
        "    full = p >= t_full\n",
        "    light = (p >= t_light) & ~full\n",
        "    none = ~full & ~light\n",
        "    return (np.sum(full * (P + y_true * (1 - e) * C))\n",
        "            + np.sum(light * (L + y_true * (1 - e_l) * C))\n",
        "            + np.sum(none * y_true * C))\n",
        "\n",
        "\n",
        "#theory on VALIDATION: which full-programme cut-off is cheapest?\n",
        "p_val = sk_model.predict_proba(Xva)[:, 1]\n",
        "thresholds = np.linspace(0, 0.6, 121)\n",
        "cost_val = [policy_cost(yva, p_val, t, min(t_low, t)) / len(yva) for t in thresholds]\n",
        "best_t = float(thresholds[np.argmin(cost_val)])\n",
        "\n",
        "plt.figure(figsize=(8, 4.5))\n",
        "plt.plot(thresholds, cost_val)\n",
        "plt.axvline(t_high, color=\"k\", ls=\"--\", label=f\"theory t_high = {t_high:.3f}\")\n",
        "plt.axvline(best_t, color=\"r\", ls=\":\", label=f\"best on validation = {best_t:.3f}\")\n",
        "plt.xlabel(\"full-programme cut-off\")\n",
        "plt.ylabel(\"average cost per applicant (EUR)\")\n",
        "plt.title(\"Cost vs cut-off (validation)\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "print(f\"theory says {t_high:.3f}, cheapest on validation is {best_t:.3f}\")"
      ],
