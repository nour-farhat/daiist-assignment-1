      "source": [
        "#Calibration\n",
        "# the cut-offs read \"15% risk\" as a real number, so the probabilities have to be honest\n",
        "def expected_calibration_error(y_true, y_prob, n_bins=10):\n",
        "    y_true, y_prob = np.asarray(y_true), np.asarray(y_prob)\n",
        "    bins = np.minimum((y_prob * n_bins).astype(int), n_bins - 1)\n",
        "    ece = 0.0\n",
        "    for b in range(n_bins):\n",
        "        mask = bins == b\n",
        "        if mask.any():\n",
        "            ece += mask.mean() * abs(y_true[mask].mean() - y_prob[mask].mean())\n",
        "    return ece\n",
        "\n",
        "\n",
        "def calibration_report(y_true, probs_by_model, n_bins=10):\n",
        "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4.5))\n",
        "    ax1.plot([0, 1], [0, 1], \"k--\", label=\"perfectly calibrated\")\n",
        "    rows = []\n",
        "    for name, p in probs_by_model.items():\n",
        "        #quantile bins: almost all predictions are below 0.4, equal-width bins would be empty\n",
        "        frac_pos, mean_pred = calibration_curve(y_true, p, n_bins=n_bins, strategy=\"quantile\")\n",
        "        ax1.plot(mean_pred, frac_pos, \"o-\", label=name)\n",
        "        ax2.hist(p, bins=30, range=(0, 1), histtype=\"step\", lw=2, label=name)\n",
        "        rows.append({\n",
        "            \"model\": name,\n",
        "            \"ROC-AUC\": roc_auc_score(y_true, p),\n",
        "            \"Brier\": brier_score_loss(y_true, p),\n",
        "            \"log loss\": log_loss(y_true, p),\n",
        "            \"ECE\": expected_calibration_error(y_true, p, n_bins),\n",
        "            \"expected CHD (sum p)\": p.sum(),\n",
        "            \"actual CHD\": int(np.sum(y_true)),\n",
        "        })\n",
        "    ax1.set(xlabel=\"mean predicted probability\", ylabel=\"observed CHD rate\", title=\"Reliability diagram\")\n",
        "    ax1.legend()\n",
        "    ax2.set(xlabel=\"predicted probability\", ylabel=\"count\", title=\"Distribution of predictions\")\n",
        "    ax2.legend()\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "    return pd.DataFrame(rows).set_index(\"model\").round(3)\n",
        "\n",
        "\n",
        "print(calibration_report(yte, p_test))"
      ],
