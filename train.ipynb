        "# business check: does the insurer need the blood test?\n",
        "# questionnaire = what the applicant can fill in; BP cuff = cheap check; full = blood test too\n",
        "questionnaire = [\"male\", \"age\", \"cigsPerDay\", \"BPMeds\", \"prevalentStroke\", \"prevalentHyp\", \"diabetes\"] + EDU\n",
        "exam_sets = {\n",
        "    \"questionnaire only\": questionnaire,\n",
