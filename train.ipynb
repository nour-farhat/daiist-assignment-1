      "source": [
        "#Model 3: standard PyTorch (nn.Module + torch.optim)\n",
        "def train_standard(lr, n_epochs, verbose=False):\n",
        "    torch.manual_seed(SEED)\n",
        "    model = nn.Sequential(\n",
        "        nn.Linear(n_features, 1),\n",
        "        nn.Sigmoid(),\n",
        "    )\n",
        "    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n",
        "    loss_fn = nn.BCELoss()\n",
        "    history = []\n",
        "    for epoch in range(n_epochs):\n",
        "        optimizer.zero_grad()\n",
        "        y_pred = model(Xtr_t).squeeze(-1)\n",
        "        loss = loss_fn(y_pred, ytr_t) + LAMBDA * (model[0].weight ** 2).sum()  # same L2 as the others\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "        history.append(loss.item())\n",
        "        if verbose and epoch % 1000 == 0:\n",
        "            print(f\"epoch {epoch:5d}  loss {loss.item():.5f}\")\n",
        "    return model, history\n",
        "\n",
        "\n",
        "rows = []\n",
        "for lr in [0.001, 0.01, 0.1]:\n",
        "    m_, h_ = train_standard(lr, N_EPOCHS)\n",
        "    with torch.no_grad():\n",
        "        p = m_(Xva_t).squeeze(-1).numpy()\n",
        "    rows.append({\"lr\": lr, \"final train loss\": h_[-1], \"val log loss\": log_loss(yva, p)})\n",
        "lr_table_std = pd.DataFrame(rows).set_index(\"lr\")\n",
        "print(lr_table_std.round(5))\n",
        "\n",
        "LR_STD = float(lr_table_std[\"val log loss\"].idxmin())\n",
        "std_model, hist_std = train_standard(LR_STD, N_EPOCHS, verbose=True)\n",
        "print(\"chosen lr:\", LR_STD)"
